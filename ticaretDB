CREATE DATABASE ETicaretDB;
GO
--DB'yi kullanma
USE ETicaretDB;
GO
--müşteriler tablosu oluşturma...
CREATE TABLE Musteriler
(
MusteriID INT IDENTITY(1,1) PRIMARY KEY,
Ad NVARCHAR(50) NOT NULL,
Soyad NVARCHAR(50) NOT NULL,
Sehir NVARCHAR(50) NOT NULL,
KayitTarihi DATE DEFAULT GETDATE()
);
GO

CREATE TABLE Urunler
(
UrunID INT IDENTITY(1,1) PRIMARY KEY,
UrunAdi NVARCHAR(100) NOT NULL,
Kategori NVARCHAR(50)NOT NULL,
Fiyat DECIMAL(10,2) NOT NULL CHECK (Fiyat > 0),
StokMiktari INT NOT NULL DEFAULT 0 CHECK (StokMiktari >= 0),
);
GO

CREATE TABLE Siparisler 
(
    SiparisID INT IDENTITY(1,1) PRIMARY KEY,
    MusteriID INT FOREIGN KEY REFERENCES Musteriler(MusteriID),
    UrunID INT FOREIGN KEY REFERENCES Urunler(UrunID),
    Adet INT CHECK (Adet > 0),
    SiparisTarihi DATETIME DEFAULT GETDATE(),
    Durum NVARCHAR(20) DEFAULT N'Hazırlanıyor'
);
GO
