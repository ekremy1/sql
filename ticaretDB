--sipariş detayları (inner join)
SELECT
    M.Ad + N' ' + M.Soyad AS [Müşteri Ad-Soyad],
    M.Sehir AS [Şehir],
    U.UrunAdi AS [Ürün Adı],
    U.Fiyat AS [Birim Fiyat],
    S.Adet AS [Adet],
    U.Fiyat * S.Adet AS [Toplam Tutar],
    S.SiparisTarihi AS [Sipariş Tarihi],
    S.Durum AS [Durum]
FROM Siparisler S
INNER JOIN Musteriler M
    ON S.MusteriID = M.MusteriID
INNER JOIN Urunler U
    ON S.UrunID = U.UrunID;
	GO
	--ciro hesaplama
	SELECT
    U.Kategori AS [Kategori],
    SUM(S.Adet) AS [ToplamAdet],
    SUM(U.Fiyat * S.Adet) AS [ToplamCiro]
FROM Siparisler S
INNER JOIN Urunler U
    ON S.UrunID = U.UrunID
GROUP BY U.Kategori;
GO
--DATEDIFF
SELECT
SiparisID AS [Sipariş No],
SiparisTarihi AS [Sipariş Tarihi],
Durum AS [Durum],
DATEDIFF(HOUR, SiparisTarihi, GETDATE())
    AS [Geçen Saat]
FROM Siparisler
WHERE Durum =N'Hazırlanıyor';
GO
--VIEW oluşturma
CREATE VIEW vw_KargolanacakSiparisler

AS 
SELECT
    M.Ad + N' ' + M.Soyad AS [Müşteri Ad-Soyad],
	M.Sehir AS [Müşteri Şehir],
	U.UrunAdi AS [Ürün Adı],
	S.Adet AS [Adet],
	S.SiparisTarihi AS [Sipariş Tarihi]
	FROM Siparisler S
	INNER JOIN Musteriler M
	ON S.MusteriID = M.MusteriID
	INNER JOIN Urunler U
	ON S.UrunID = U.UrunID
	WHERE S.Durum =N'Hazırlanıyor';
	GO

	SELECT * FROM vw_KargolanacakSiparisler;
	GO
--stok durumu

CREATE PROCEDURE sp_SiparisOlustur
    @MusteriID INT,
    @UrunID INT,
    @Adet INT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @MevcutStok INT;

    -- Adet kontrolü
    IF @Adet <= 0
    BEGIN
        PRINT N'Hata: Sipariş adedi sıfırdan büyük olmalıdır!';
        RETURN;
    END;

    -- Ürünün mevcut stok miktarını al
    SELECT @MevcutStok = StokMiktari
    FROM Urunler
    WHERE UrunID = @UrunID;

    -- Ürün mevcut değilse
    IF @MevcutStok IS NULL
    BEGIN
        PRINT N'Hata: Ürün bulunamadı!';
        RETURN;
    END;

    -- Stok yeterliyse
    IF @MevcutStok >= @Adet
    BEGIN
        BEGIN TRY
            BEGIN TRANSACTION;

            INSERT INTO Siparisler
                (MusteriID, UrunID, Adet, Durum)
            VALUES
                (@MusteriID, @UrunID, @Adet, N'Hazırlanıyor');

            UPDATE Urunler
            SET StokMiktari = StokMiktari - @Adet
            WHERE UrunID = @UrunID;

            COMMIT TRANSACTION;

            PRINT N'Sipariş başarıyla oluşturuldu ve stok güncellendi.';
        END TRY
        BEGIN CATCH
            IF @@TRANCOUNT > 0
                ROLLBACK TRANSACTION;

            THROW;
        END CATCH;
    END
    ELSE
    BEGIN
        PRINT N'Hata: Yetersiz stok miktarı!';
    END;
END;
GO
