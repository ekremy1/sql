--veritabanı oluşturma
CREATE DATABASE KutuphaneeDB;
GO

USE KutuphaneeDB;
GO
--tablo oluşturma
CREATE TABLE Ogrenciler
(
    OgrenciID INT IDENTITY(1,1) PRIMARY KEY,
    Ad NVARCHAR(50) NOT NULL,
    Soyad NVARCHAR(50) NOT NULL,
    Bolum NVARCHAR(100) NOT NULL,
    KayitTarihi DATE DEFAULT GETDATE()
);
GO
CREATE TABLE Kitaplar
(
    KitapID INT IDENTITY(1,1) PRIMARY KEY,
    KitapAdi NVARCHAR(100) NOT NULL,
    Yazar NVARCHAR(100) NOT NULL,
    StokAdedi INT DEFAULT 1 CHECK (StokAdedi >= 0)
);
GO
CREATE TABLE OduncIslemleri
(
    OduncID INT IDENTITY(1,1) PRIMARY KEY,
    OgrenciID INT NOT NULL,
    KitapID INT NOT NULL,
    AlisTarihi DATE DEFAULT GETDATE(),
    TeslimTarihi DATE NULL,

    CONSTRAINT FK_Odunc_Ogrenci
        FOREIGN KEY (OgrenciID)
        REFERENCES Ogrenciler(OgrenciID),

    CONSTRAINT FK_Odunc_Kitap
        FOREIGN KEY (KitapID)
        REFERENCES Kitaplar(KitapID)
);
GO
