	--innerjoin
	SELECT 
    Ogrenciler.Ad + ' ' + Ogrenciler.Soyad AS [Öğrenci Ad-Soyad],
    Kitaplar.KitapAdi AS [Kitap Adı],
    OduncIslemleri.AlisTarihi AS [Alış Tarihi],
    CASE
        WHEN OduncIslemleri.TeslimTarihi IS NULL 
            THEN 'Teslim Edilmedi'
        ELSE 'Teslim Edildi'
    END AS [Teslim Durumu]
FROM OduncIslemleri
INNER JOIN Ogrenciler
    ON OduncIslemleri.OgrenciID = Ogrenciler.OgrenciID
INNER JOIN Kitaplar
    ON OduncIslemleri.KitapID = Kitaplar.KitapID;
	GO
	--left join/group by
	SELECT
    Ogrenciler.Bolum AS [Bölüm Adı],
    COUNT(OduncIslemleri.OduncID) AS [Toplam Ödünç Sayısı]
FROM Ogrenciler
LEFT JOIN OduncIslemleri
    ON Ogrenciler.OgrenciID = OduncIslemleri.OgrenciID
GROUP BY Ogrenciler.Bolum;
GO
--datediff/where
SELECT
    Ogrenciler.Ad + ' ' + Ogrenciler.Soyad AS [Öğrenci Ad-Soyad],
    Kitaplar.KitapAdi AS [Kitap Adı],
    DATEDIFF(DAY, OduncIslemleri.AlisTarihi, GETDATE()) AS [Kaç Gündür Öğrencide]
FROM OduncIslemleri
INNER JOIN Ogrenciler
    ON OduncIslemleri.OgrenciID = Ogrenciler.OgrenciID
INNER JOIN Kitaplar
    ON OduncIslemleri.KitapID = Kitaplar.KitapID
WHERE OduncIslemleri.TeslimTarihi IS NULL;
GO


--create view
USE KutuphaneeDB;
GO

CREATE VIEW AktifOdunc
AS
SELECT
    Ogrenciler.Ad + ' ' + Ogrenciler.Soyad AS [Öğrenci Ad-Soyad],
    Kitaplar.KitapAdi AS [Kitap Adı],
    OduncIslemleri.AlisTarihi AS [Alış Tarihi]
FROM OduncIslemleri
INNER JOIN Ogrenciler
    ON OduncIslemleri.OgrenciID = Ogrenciler.OgrenciID
INNER JOIN Kitaplar
    ON OduncIslemleri.KitapID = Kitaplar.KitapID
WHERE OduncIslemleri.TeslimTarihi IS NULL;
GO
SELECT * FROM AktifOdunc;

--create procedure

USE KutuphaneeDB;
GO
CREATE PROCEDURE sp_KitapOduncVer
    @OgrenciID INT,
    @KitapID INT
AS
BEGIN

    DECLARE @Stok INT;

    -- Kitabın mevcut stok miktarını al
    SELECT @Stok = StokAdedi
    FROM Kitaplar
    WHERE KitapID = @KitapID;

    -- Stok 0'dan büyükse kitap ödünç ver
    IF @Stok > 0
    BEGIN

        -- Ödünç işlemini kaydet
        INSERT INTO OduncIslemleri
            (OgrenciID, KitapID, AlisTarihi, TeslimTarihi)
        VALUES
            (@OgrenciID, @KitapID, GETDATE(), NULL);

        -- Kitap stok miktarını 1 azalt
        UPDATE Kitaplar
        SET StokAdedi = StokAdedi - 1
        WHERE KitapID = @KitapID;

        PRINT 'Kitap başarıyla ödünç verildi.';

    END

    -- Stok 0 ise işlem yapma
    ELSE
    BEGIN

        PRINT 'Hata: Seçilen kitabın stoğu tükenmiştir!';

    END
END;
GO
EXEC sp_KitapOduncVer
    @OgrenciID = 1,
    @KitapID = 1;
